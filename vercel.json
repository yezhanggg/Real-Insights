{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "trailingSlash": false,
  "headers": [
    { "source": "/data/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=3600, must-revalidate" }, { "key": "Access-Control-Allow-Origin", "value": "*" }] },
    { "source": "/feed.xml", "headers": [{ "key": "Content-Type", "value": "application/rss+xml; charset=utf-8" }] }
  ],
  "rewrites": [{ "source": "/((?!api/|data/|assets/|feed.xml|sitemap.xml|favicon.svg|og.png|robots.txt).*)", "destination": "/index.html" }]
}
