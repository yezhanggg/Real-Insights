# Copy to .env and fill in. .env is git-ignored; never commit keys.
# Every key below is SERVER-SIDE ONLY (read by api/*.ts). None of them starts with VITE_, so none reaches the browser.

# --- The agent ("Ask the map") ---------------------------------------------
# DeepSeek: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=
# Optional. Defaults to deepseek-flash. deepseek-v4-pro is slower, smarter, pricier.
DEEPSEEK_MODEL=deepseek-flash

# --- Subscriptions (pick one; Buttondown is checked first) ------------------
# Buttondown sends the "new map is up" emails for you and can mail /feed.xml automatically.
BUTTONDOWN_API_KEY=
# Or keep the list in your own Supabase table (see supabase/migrations/0001_subscribers.sql).
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# --- Data pipeline (pipeline/*.py, never the website) -----------------------
# US Census Bureau API key (free): https://api.census.gov/data/key_signup.html
CENSUS_API_KEY=
